<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:label="@string/app_name"
        android:theme="@style/Theme.DropletID"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/regles_sauvegarde"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/reseau">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- « Ouvrir dans Droplet ID » depuis la page de connexion :
                 https://id.dropletmesh.app/a/<demande>. Sans vérification de
                 domaine (assetlinks) tant que le serveur ne déclare pas cette
                 app : Android propose alors de choisir l'app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="id.dropletmesh.app" android:pathPrefix="/a/" />
                <data android:scheme="https" android:host="id-test.dropletmesh.app" android:pathPrefix="/a/" />
            </intent-filter>
        </activity>
    </application>
</manifest>

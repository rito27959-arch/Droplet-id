<resources>
    <!-- Thème de la fenêtre seulement : tout l'écran est en Compose (Glasmio).
         Le fond est celui de l'app pour qu'aucun éclair blanc n'apparaisse. -->
    <style name="Theme.DropletID" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">#F6F5F2</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>

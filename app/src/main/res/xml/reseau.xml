<?xml version="1.0" encoding="utf-8"?>
<!-- Aucun trafic en clair, aucune autorité ajoutée par l'utilisateur. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

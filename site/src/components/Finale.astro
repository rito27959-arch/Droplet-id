---
// LA FIN DE CHAQUE PAGE — Droplet Design Language : le dernier appel, posé,
// sans mise en scène. Le même texte qu'avant.
import { lien, SOURCES } from '../site';
---
<section class="fin contenu--large" aria-labelledby="titre-fin">
  <h2 id="titre-fin" class="headline">Bouclez votre identité.</h2>
  <p class="chapo">Gratuit. Pour Android 12 ou plus récent.</p>
  <div class="actions">
    <a class="bouton" href={lien('/telecharger/')}>Télécharger Droplet ID</a>
    <a class="bouton bouton--secondaire" href={SOURCES}>Voir le code source</a>
  </div>
</section>

<style>
  .fin {
    padding-top: var(--e-9);
  }
  .chapo {
    margin-top: var(--e-4);
  }
  .actions {
    margin-top: var(--e-6);
  }
</style>

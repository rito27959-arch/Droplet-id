---
// ============================================================================
// LE LOGO, EN PIÈCES — pour pouvoir le boucler à l'écran.
// La plaque métal (et la sangle qui la tire) glisse le long de l'axe de la
// sangle jusqu'au boîtier. La variable CSS --boucle (0 → 1) pilote le geste :
// 0 = ceinture ouverte, 1 = bouclée. Sans script, le logo est bouclé.
// ============================================================================
interface Props { id: string; taille?: number; fond?: boolean; class?: string; label?: string }
const { id, taille = 168, fond = true, class: classe = '', label } = Astro.props;
const HEART = 'M256 380 C 152 316 122 262 122 220 C 122 176 156 146 196 146 C 225 146 246 163 256 184 C 266 163 287 146 316 146 C 356 146 390 176 390 220 C 390 262 360 316 256 380 Z';
const CY = 262;
---
<svg class={`logo ${classe}`} viewBox="0 0 512 512" width={taille} height={taille}
     role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
  <defs>
    <linearGradient id={`${id}-argent`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#F5F6F8"/><stop offset=".55" stop-color="#C9CCD1"/><stop offset="1" stop-color="#8B9097"/></linearGradient>
    <linearGradient id={`${id}-metal`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#FFFFFF"/><stop offset=".5" stop-color="#C3C6CC"/><stop offset="1" stop-color="#8E939A"/></linearGradient>
    <linearGradient id={`${id}-noir`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2A2C31"/><stop offset="1" stop-color="#0E0F12"/></linearGradient>
    <radialGradient id={`${id}-fond`} cx=".5" cy=".42" r=".7"><stop offset="0" stop-color="#1B1C20"/><stop offset="1" stop-color="#050506"/></radialGradient>
    <pattern id={`${id}-tissage`} width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="7" height="7" fill="#33363C"/><rect width="3" height="7" fill="#3D4047"/></pattern>
    <clipPath id={`${id}-clip`}><path d={HEART} transform="translate(256 262) scale(1.16) translate(-256 -262)"/></clipPath>
    <radialGradient id={`${id}-eclat`} cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#fff" stop-opacity=".9"/><stop offset="1" stop-color="#fff" stop-opacity="0"/></radialGradient>
  </defs>
  {fond && <rect width="512" height="512" fill={`url(#${id}-fond)`}/>}
  <path class="logo-coeur" d={HEART} fill={`url(#${id}-argent)`}/>
  <g transform="rotate(-30 256 262)">
    <!-- l'ancrage, fixe, qui part du boîtier -->
    <g clip-path={`url(#${id}-clip)`}><rect x="386" y={CY - 22} width="260" height="44" fill={`url(#${id}-tissage)`}/></g>
    <!-- la sangle et sa plaque : la partie qui bouge -->
    <g class="logo-plaque">
      <g clip-path={`url(#${id}-clip)`}>
        <rect x="-120" y={CY - 27} width="352" height="54" fill={`url(#${id}-tissage)`}/>
        <rect x="-120" y={CY - 27} width="352" height="3" fill="#565A62"/>
        <rect x="-120" y={CY + 24} width="352" height="3" fill="#1D1F23"/>
      </g>
      <rect x="214" y={CY - 36} width="62" height="72" rx="12" fill={`url(#${id}-metal)`}/>
      <rect x="226" y={CY - 14} width="30" height="28" rx="6" fill="#2A2C31"/>
      <rect x="270" y={CY - 18} width="34" height="36" rx="4" fill={`url(#${id}-metal)`}/>
    </g>
    <!-- le boîtier et son bouton rouge -->
    <rect x="292" y={CY - 40} width="104" height="80" rx="22" fill={`url(#${id}-noir)`} stroke="#9EA3AA" stroke-width="3"/>
    <rect class="logo-bouton" x="306" y={CY - 20} width="34" height="40" rx="9" fill="#E03A2F"/>
    <rect x="352" y={CY - 6} width="32" height="12" rx="6" fill="#4B4E55"/>
    <!-- l'éclat du « clic » -->
    <circle class="logo-eclat" cx="290" cy={CY} r="70" fill={`url(#${id}-eclat)`}/>
  </g>
</svg>

<style>
  .logo { display: block; overflow: visible; --boucle: 1; }
  .logo .logo-plaque { transform: translateX(calc((1 - var(--boucle)) * -96px)); }
  .logo .logo-eclat { opacity: 0; transform-box: fill-box; transform-origin: center; }
  .logo.clic .logo-eclat { animation: eclat 700ms cubic-bezier(.16,1,.3,1); }
  .logo.clic .logo-bouton { animation: bouton 700ms cubic-bezier(.16,1,.3,1); }
  @keyframes eclat { 0% { opacity: 0; transform: scale(.4); } 25% { opacity: .85; } 100% { opacity: 0; transform: scale(1.6); } }
  @keyframes bouton { 0%, 100% { filter: none; } 30% { filter: brightness(1.6) drop-shadow(0 0 14px #E03A2F); } }
</style>

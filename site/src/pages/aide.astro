---
// AIDE — les questions fréquentes, qui s'ouvrent en douceur.
import Page from '../layouts/Page.astro';
import { SIGNALER, lien } from '../site';
const questions = [
  ["J'ai perdu mon téléphone. Que se passe-t-il ?", "Votre clé était dans ce téléphone, et seulement là. Pour l'instant, il n'y a pas de récupération : vous créez une nouvelle identité sur votre nouveau téléphone, puis vous vous reconnectez à vos apps. Une récupération depuis un autre appareil est prévue."],
  ["Pourquoi pas de mot de passe ?", "Un mot de passe peut être deviné, réutilisé ou volé par une fausse page. Une clé qui ne quitte jamais votre téléphone ne peut pas l'être. Vous prouvez qui vous êtes en approuvant, avec le verrouillage de votre téléphone."],
  ["Droplet voit-il mes données ?", "Droplet ID ne connaît ni votre numéro, ni votre e-mail, ni votre nom. Le serveur garde la partie publique de votre clé, le modèle de votre téléphone et la liste des apps que vous avez autorisées."],
  ["Sur quels téléphones Droplet ID fonctionne-t-il ?", "Sur Android 12 ou plus récent, avec un verrouillage de l'écran. Il n'existe pas encore de version iPhone."],
  ["Comment installer l'APK ?", "Téléchargez le fichier, ouvrez-le, puis autorisez votre navigateur à installer des apps quand Android le demande. Droplet ID n'est pas encore sur le Play Store."],
  ["Comment retirer l'accès à une app ?", "Dans Droplet ID, ouvrez « Apps connectées », touchez l'app, puis « Retirer l'accès ». Elle ne vous reconnaîtra plus."],
  ["Comment tout effacer ?", "Dans Droplet ID, « Oublier ce téléphone » efface la clé et retire l'appareil de votre compte. C'est définitif."],
  ["Comment signaler un problème ?", "Ouvrez un ticket sur la page GitHub du projet. Ne joignez jamais de capture qui montre un code de connexion."],
];
---
<Page titre="Aide" description="Les réponses aux questions fréquentes sur Droplet ID." courant="aide">
  <section class="surtitre-page">
    <div class="conteneur etroit">
      <p class="sur apparait">Aide</p>
      <h1 class="titre-1 apparait" style="--d:1">Questions fréquentes.</h1>
    </div>
  </section>
  <section class="bloc-faq">
    <div class="conteneur etroit faq">
      {questions.map(([q, r], i) => (
        <details class="apparait" style={`--d:${Math.min(i, 5)}`} name="faq">
          <summary><span>{q}</span><i aria-hidden="true"></i></summary>
          <p class="texte">{r}</p>
        </details>
      ))}
      <p class="texte autre apparait">Une autre question ? <a href={SIGNALER}>Écrivez-nous sur GitHub</a>, ou lisez <a href={lien('/securite/')}>comment Droplet ID protège votre clé</a>.</p>
    </div>
  </section>
</Page>

<style>
  .sur { margin: 0 0 16px; font-size: 14px; font-weight: 600; color: var(--argent-2); }
  .etroit { width: min(820px, 100% - 40px); }
  .bloc-faq { padding-bottom: 140px; }
  .faq { display: flex; flex-direction: column; }
  details { border-top: 1px solid var(--trait); interpolate-size: allow-keywords; }
  details:last-of-type { border-bottom: 1px solid var(--trait); }
  details::details-content { height: 0; overflow: hidden; transition: height 500ms var(--courbe), content-visibility 500ms allow-discrete; }
  details[open]::details-content { height: auto; }
  summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: 26px 0; font: 600 clamp(18px, 2vw, 22px)/1.3 var(--titres); letter-spacing: -0.015em; }
  summary::-webkit-details-marker { display: none; }
  summary i { position: relative; flex: none; width: 28px; height: 28px; border-radius: 50%; border: 1px solid var(--trait); transition: transform 400ms var(--courbe), background 300ms; }
  summary i::before, summary i::after { content: ''; position: absolute; left: 50%; top: 50%; width: 10px; height: 1.5px; background: var(--argent); transform: translate(-50%, -50%); }
  summary i::after { transform: translate(-50%, -50%) rotate(90deg); transition: transform 400ms var(--courbe); }
  details[open] summary i { transform: rotate(180deg); background: rgba(255,255,255,.06); }
  details[open] summary i::after { transform: translate(-50%, -50%) rotate(0); }
  details p { padding: 0 0 28px; max-width: 62ch; }
  .autre { margin-top: 40px; }
  .autre a { color: var(--argent); }
</style>

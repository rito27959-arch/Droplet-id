---
// ============================================================================
// L'ACCUEIL DE DROPLET ID — Droplet Design Language, le gabarit commun des
// pages produit : 1 héros · 2 démonstration (trois gestes) · 3 la clé reste
// ici · 4 un identifiant par app · 5 retirer un accès · fin.
// Une seule animation forte : la démonstration, pilotée par le défilement
// (CSS). Sans prise en charge ou avec « réduire les animations », les trois
// étapes se lisent à la suite et l'écran montre le nombre à vérifier.
// Rien d'inventé : chaque phrase décrit ce que l'app fait aujourd'hui.
// ============================================================================
import Page from '../layouts/Page.astro';
import Logo from '../components/Logo.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const APK = 'https://github.com/rito27959-arch/Droplet-id/raw/telechargements/droplet-id.apk';
const SOURCES = 'https://github.com/rito27959-arch/Droplet-id';
const titre = 'Droplet ID — votre identité, bouclée.';
const description = "Une identité pour tout Droplet. Sans mot de passe, sans e-mail. Vous approuvez chaque connexion d'un geste, et vous retirez un accès quand vous voulez.";

// Un faux QR, décoratif et toujours le même (21 × 21), pour l'écran « scanner ».
const qr: string[] = [];
let graine = 7;
for (let y = 0; y < 21; y++) for (let x = 0; x < 21; x++) {
  const coin = (x < 7 && y < 7) || (x > 13 && y < 7) || (x < 7 && y > 13);
  graine = (graine * 1103515245 + 12345) % 2147483648;
  if (!coin && graine % 100 < 46) qr.push(`M${x} ${y}h1v1h-1z`);
}
const coins = [[0, 0], [14, 0], [0, 14]];
---
<Page titre="Droplet ID — votre identité, bouclée." description={description}>

  <!-- 1. Héros -->
  <section class="heros contenu--large" aria-labelledby="titre">
    <div class="heros__texte">
      <h1 id="titre" class="display revele">Votre identité. Bouclée.</h1>
      <p class="chapo revele">Une seule identité pour Droplet Messenger, Droplet Drop et Kunfox. Elle vit dans votre téléphone, et nulle part ailleurs.</p>
      <div class="actions revele">
        <a class="bouton" href={APK}>Télécharger pour Android</a>
        <a class="bouton bouton--secondaire" href="#fonctionnement">Voir comment ça marche</a>
      </div>
      <p class="caption revele">Gratuit. Pour Android 12 ou plus récent. En test, pas encore sur le Play Store.</p>
    </div>
    <div class="heros__logo boite-logo"><Logo id="hero" taille={320} label="Le logo de Droplet ID : un cœur argenté tenu par une ceinture de sécurité" /></div>
  </section>

  <!-- 2. Démonstration : les trois gestes. Le téléphone reste, l'écran change. -->
  <section class="demo" id="fonctionnement" aria-labelledby="titre-gestes">
    <div class="demo__colle contenu--large">
      <div class="demo__texte">
        <h2 id="titre-gestes" class="headline">Sans mot de passe. Sans e-mail.</h2>
        <p class="chapo">Pour vous connecter, vous ne tapez rien que l'on puisse vous voler. Vous approuvez, sur votre téléphone.</p>
        <ol class="etapes">
          <li class="etape e1"><span class="technique doux">1</span><span><strong>Scannez le code.</strong> Le site ou l'app affiche un QR. Droplet ID le lit.</span></li>
          <li class="etape e2"><span class="technique doux">2</span><span><strong>Vérifiez le nombre.</strong> Vous recopiez le nombre affiché par le site. Une fausse page ne peut pas le deviner.</span></li>
          <li class="etape e3"><span class="technique doux">3</span><span><strong>Approuvez.</strong> Votre empreinte ou le code de votre téléphone, et c'est fait.</span></li>
        </ol>
      </div>

      <div class="telephone" role="img" aria-label="Trois écrans de Droplet ID : scanner le code, vérifier le nombre 482 913, connexion approuvée">
        <div class="ecran">
          <div class="vue vue-scan">
            <div class="viseur">
              <svg viewBox="-1 -1 23 23" class="qr" aria-hidden="true">
                <path d={qr.join('')} fill="#e6e8eb"/>
                {coins.map(([x, y]) => (<g><rect x={x + 0.5} y={y + 0.5} width="6" height="6" fill="none" stroke="#e6e8eb" stroke-width="1"/><rect x={x + 2} y={y + 2} width="3" height="3" fill="#e6e8eb"/></g>))}
              </svg>
              <i class="c c1"></i><i class="c c2"></i><i class="c c3"></i><i class="c c4"></i>
            </div>
            <p class="vue-texte">Visez le code affiché par l'app</p>
          </div>
          <div class="vue vue-code">
            <div class="feuille">
              <div class="poignee"></div>
              <img class="app-icone" src={`${base}/apps/kunfox.webp`} alt="" width="52" height="52" />
              <p class="feuille-titre">Se connecter à Kunfox ?</p>
              <p class="feuille-sous">kunfox.app</p>
              <div class="code-boite">
                <span class="code-aide">Le nombre affiché sur kunfox.app</span>
                <span class="code">482 913</span>
              </div>
              <div class="lignes">
                <div><span>Kunfox recevra</span><span>Identifiant, pseudo</span></div>
                <div><span>Expire dans</span><span class="chiffres">4:52</span></div>
              </div>
              <div class="btn-approuver">Se connecter</div>
            </div>
          </div>
          <div class="vue vue-ok">
            <svg class="coche" viewBox="0 0 120 120" aria-hidden="true"><circle cx="60" cy="60" r="52" /><path d="M38 62l15 15 30-32" /></svg>
            <p class="ok-titre">Connecté à Kunfox</p>
            <p class="ok-sous">Vous pouvez revenir à l'app.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. La clé reste ici -->
  <section class="section contenu--large" id="securite" aria-labelledby="titre-cle">
    <h2 id="titre-cle" class="headline">Votre clé ne quitte jamais ce téléphone.</h2>
    <p class="chapo espace">Droplet ID crée une clé sur votre téléphone. Personne d'autre ne la possède, pas même Droplet.</p>
    <ul class="grille-filets">
      <li><h3 class="subtitle">Créée ici</h3><p class="body doux">Une clé Ed25519 naît dans le téléphone. Elle signe vos approbations ; elle n'est jamais envoyée.</p></li>
      <li><h3 class="subtitle">Gardée par la puce</h3><p class="body doux">Elle est chiffrée par le Keystore d'Android, et par la puce de sécurité quand le téléphone en a une.</p></li>
      <li><h3 class="subtitle">Hors des sauvegardes</h3><p class="body doux">Elle ne part ni dans le cloud ni vers un autre téléphone. Elle ne peut pas être copiée.</p></li>
      <li><h3 class="subtitle">Rien de personnel</h3><p class="body doux">Ni numéro, ni e-mail, ni nom. Un pseudo, seulement si vous choisissez de le partager.</p></li>
    </ul>
    <a class="lien espace-lien" href={`${base}/securite/`}>Comment Droplet ID protège votre identité</a>
  </section>

  <!-- 4. Un identifiant par app -->
  <section class="section contenu--large deux" id="apps" aria-labelledby="titre-apps">
    <div>
      <h2 id="titre-apps" class="headline">Un identifiant différent pour chaque app.</h2>
      <p class="chapo espace">Chaque app reçoit un identifiant qui ne vaut que pour elle. Deux apps ne peuvent pas savoir qu'il s'agit de vous.</p>
    </div>
    <div>
      <ul class="liste-apps" aria-label="Apps qui utilisent Droplet ID">
        <li><img src={`${base}/apps/messenger.webp`} alt="" width="40" height="40" /><span class="label">Droplet Messenger</span><span class="technique doux" dir="ltr">id · 7f3a…c21</span></li>
        <li><img src={`${base}/apps/drop.webp`} alt="" width="40" height="40" /><span class="label">Droplet Drop</span><span class="technique doux" dir="ltr">id · b90e…4d7</span></li>
        <li><img src={`${base}/apps/kunfox.webp`} alt="" width="40" height="40" /><span class="label">Kunfox</span><span class="technique doux" dir="ltr">id · 15c8…e02</span></li>
      </ul>
      <p class="caption espace-note">Trois apps, trois identifiants sans lien entre eux. Les identifiants affichés sont des exemples.</p>
    </div>
  </section>

  <!-- 5. Retirer un accès -->
  <section class="section contenu--large deux" aria-labelledby="titre-retirer">
    <div>
      <h2 id="titre-retirer" class="headline">Retirer un accès prend une seconde.</h2>
      <p class="chapo espace">Vous voyez chaque app qui utilise votre identité, depuis quand, et ce qu'elle reçoit. Un geste, et elle ne vous reconnaît plus.</p>
    </div>
    <ul class="liste-apps liste-acces" aria-hidden="true">
      <li><img src={`${base}/apps/messenger.webp`} alt="" width="40" height="40" /><span class="label">Droplet Messenger</span><span class="caption">il y a 11 j</span></li>
      <li><img src={`${base}/apps/drop.webp`} alt="" width="40" height="40" /><span class="label">Droplet Drop</span><span class="caption">il y a 3 j</span></li>
      <li><img src={`${base}/apps/kunfox.webp`} alt="" width="40" height="40" /><span class="label">Kunfox</span><span class="retirer">Retirer l'accès</span></li>
    </ul>
  </section>

</Page>

<style>
  .actions { margin-top: var(--e-6); }
  .espace { margin-top: var(--e-4); }

  /* 1. Héros */
  .heros { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: var(--e-8); align-items: center; padding-top: var(--e-8); }
  .heros__texte .chapo { margin-top: var(--e-5); }
  .heros__texte .caption { margin-top: var(--e-4); }
  .heros__logo { justify-self: center; width: min(100%, 320px); aspect-ratio: 1; border: 1px solid var(--trait); }
  .revele { animation: revele 400ms var(--sortie) both; }
  .revele:nth-child(2) { animation-delay: 50ms; }
  .revele:nth-child(3) { animation-delay: 90ms; }
  .revele:nth-child(4) { animation-delay: 120ms; }
  @keyframes revele { from { opacity: 0; transform: translateY(8px); } }

  /* 2. Démonstration */
  .demo { margin-top: var(--e-9); padding-block: var(--e-8); background: var(--surface); border-block: 1px solid var(--trait); }
  .demo__colle { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: var(--e-8); align-items: center; }
  .demo .chapo { margin-top: var(--e-4); }
  .etapes { list-style: none; margin: var(--e-6) 0 0; padding: 0; display: grid; gap: var(--e-3); max-width: 56ch; }
  .etape { display: flex; gap: var(--e-3); font-size: 18px; line-height: 1.5; }
  .etape strong { font-weight: 650; }

  /* Les écrans de l'app, tels qu'ils sont : leur propre nuit, quel que soit le thème. */
  .telephone { justify-self: center; width: 300px; aspect-ratio: 9 / 19; border-radius: 40px; padding: 8px; background: #05070a; border: 1px solid var(--trait); }
  .ecran { position: relative; height: 100%; border-radius: 32px; background: #0b0f13; overflow: hidden; color: #edf1f4; font-family: var(--police); }
  .vue { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; opacity: 0; }
  .vue-code { opacity: 1; justify-content: flex-end; }
  .viseur { position: relative; width: 62%; aspect-ratio: 1; padding: 10%; }
  .qr { width: 100%; height: 100%; opacity: .9; }
  .c { position: absolute; width: 22%; height: 22%; border: 3px solid #edf1f4; }
  .c1 { top: 0; left: 0; border-right: 0; border-bottom: 0; border-top-left-radius: 14px; }
  .c2 { top: 0; right: 0; border-left: 0; border-bottom: 0; border-top-right-radius: 14px; }
  .c3 { bottom: 0; left: 0; border-right: 0; border-top: 0; border-bottom-left-radius: 14px; }
  .c4 { bottom: 0; right: 0; border-left: 0; border-top: 0; border-bottom-right-radius: 14px; }
  .vue-texte { margin: 28px 0 0; font-size: 13px; color: #8d97a1; }
  .feuille { width: 100%; background: #12171c; border-radius: 26px 26px 0 0; padding: 10px 16px 22px; display: flex; flex-direction: column; align-items: center; border-top: 1px solid #1d242b; }
  .poignee { width: 36px; height: 5px; border-radius: 999px; background: #1d242b; margin-bottom: 14px; }
  .app-icone { width: 48px; height: 48px; border-radius: 12px; }
  .feuille-titre { margin: 10px 0 2px; font-weight: 650; font-size: 17px; }
  .feuille-sous { margin: 0; font-size: 12px; color: #8d97a1; }
  .code-boite { align-self: stretch; margin-top: 14px; background: #0b0f13; border-radius: 14px; padding: 12px; display: flex; flex-direction: column; align-items: center; gap: 6px; }
  .code-aide { font-size: 11px; color: #8d97a1; }
  .code { font: 500 26px/1 var(--police-mono); letter-spacing: 0.04em; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .lignes { align-self: stretch; margin-top: 8px; background: #0b0f13; border-radius: 14px; }
  .lignes div { display: flex; justify-content: space-between; padding: 10px 12px; font-size: 12px; }
  .lignes div + div { border-top: 1px solid #1d242b; }
  .lignes span:last-child { color: #8d97a1; }
  .chiffres { font-variant-numeric: tabular-nums; }
  .btn-approuver { align-self: stretch; margin-top: 14px; height: 42px; border-radius: 999px; display: grid; place-items: center; font-weight: 600; font-size: 14px; color: #05070a; background: #edf1f4; }
  .coche { width: 104px; height: 104px; fill: none; stroke: #edf1f4; stroke-width: 5; stroke-linecap: round; stroke-linejoin: round; }
  .coche circle { stroke: #1d242b; }
  .ok-titre { margin: 20px 0 4px; font-weight: 650; font-size: 19px; }
  .ok-sous { margin: 0; font-size: 13px; color: #8d97a1; }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .demo { height: 300vh; padding: 0; view-timeline-name: --demo; }
      .demo__colle { position: sticky; top: 64px; height: calc(100svh - 64px); align-content: center; }
      .etapes { min-height: 4.6em; }
      .etape { grid-area: 1 / 1; }
      .e1, .e2, .e3, .vue-scan, .vue-code, .vue-ok {
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --demo;
        animation-range: contain 0% contain 100%;
      }
      .e1, .vue-scan { animation-name: un; }
      .e2, .vue-code { animation-name: deux; }
      .e3, .vue-ok { animation-name: trois; }
    }
  }
  @keyframes un {
    0%, 28% { opacity: 1; transform: none; }
    33%, 100% { opacity: 0; transform: translateY(-8px); }
  }
  @keyframes deux {
    0%, 31% { opacity: 0; transform: translateY(8px); }
    36%, 60% { opacity: 1; transform: none; }
    65%, 100% { opacity: 0; transform: translateY(-8px); }
  }
  @keyframes trois {
    0%, 63% { opacity: 0; transform: translateY(8px); }
    68%, 100% { opacity: 1; transform: none; }
  }

  /* 3. La clé */
  .grille-filets { list-style: none; margin: var(--e-7) 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--trait); }
  .grille-filets li { display: grid; gap: var(--e-2); align-content: start; padding: var(--e-5) var(--e-5) var(--e-6) 0; }
  .grille-filets li + li { padding-inline-start: var(--e-5); border-inline-start: 1px solid var(--trait); }
  .espace-lien { display: inline-block; margin-top: var(--e-3); }

  /* 4 et 5. Listes d'apps */
  .deux { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: var(--e-6) var(--e-8); align-items: start; }
  .liste-apps { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--trait); }
  .liste-apps li { display: grid; grid-template-columns: 40px minmax(0, 1fr) auto; gap: var(--e-4); align-items: center; padding: var(--e-4) 0; border-bottom: 1px solid var(--trait); }
  .liste-apps img { border-radius: 10px; }
  .espace-note { margin-top: var(--e-3); }
  .retirer { font-size: 14px; font-weight: 600; color: var(--erreur); }

  @media (max-width: 900px) {
    .heros, .demo__colle, .deux { grid-template-columns: 1fr; gap: var(--e-6); }
    .heros__logo { width: min(100%, 240px); justify-self: start; }
    .telephone { width: 240px; }
    .grille-filets { grid-template-columns: 1fr; }
    .grille-filets li, .grille-filets li + li { padding: var(--e-4) 0; border-inline-start: 0; }
    .grille-filets li + li { border-top: 1px solid var(--trait); }
  }
  @media (max-width: 900px) and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .demo__colle { gap: var(--e-4); }
      .demo .chapo { display: none; }
      .etapes { margin-top: var(--e-3); min-height: 6em; }
      .telephone { width: min(220px, 56vw, 40svh); }
      .code { font-size: 20px; }
      .feuille-titre { font-size: 14px; }
      .lignes div { font-size: 10.5px; padding: 8px 10px; }
    }
  }
</style>

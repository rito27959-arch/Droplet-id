---
// ============================================================================
// LE SITE DE DROPLET ID — un récit qui avance avec le défilement.
//   1. La ceinture se boucle sur le cœur (clic) : « Bouclée. »
//   2. Le téléphone reste à l'écran pendant les trois gestes de connexion.
//   3. La clé reste ici : le titre s'allume mot à mot.
//   4. Un fil part du logo vers chaque app.
//   5. Un accès se retire sous vos yeux.
//   6. Fin : le nom monte, la ceinture se reboucle.
// Rien d'inventé : chaque phrase décrit ce que l'app fait aujourd'hui.
// Sans JavaScript ou avec « réduire les animations », tout s'affiche à l'état final.
// ============================================================================
import '@fontsource-variable/inter-tight';
import '@fontsource-variable/inter';
import '../styles/global.css';
import Logo from '../components/Logo.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const APK = 'https://github.com/rito27959-arch/Droplet-id/raw/telechargements/droplet-id.apk';
const SOURCES = 'https://github.com/rito27959-arch/Droplet-id';
const titre = 'Droplet ID — votre identité, bouclée.';
const description = "Une identité pour tout Droplet. Sans mot de passe, sans e-mail. Vous approuvez chaque connexion d'un geste, et vous retirez un accès quand vous voulez.";

// Un faux QR, décoratif et toujours le même (21 × 21), pour l'écran « scanner ».
const qr: string[] = [];
let graine = 7;
for (let y = 0; y < 21; y++) for (let x = 0; x < 21; x++) {
  const coin = (x < 7 && y < 7) || (x > 13 && y < 7) || (x < 7 && y > 13);
  graine = (graine * 1103515245 + 12345) % 2147483648;
  if (!coin && graine % 100 < 46) qr.push(`M${x} ${y}h1v1h-1z`);
}
const coins = [[0, 0], [14, 0], [0, 14]];
const motSecurite = 'Votre clé ne quitte jamais ce téléphone.'.split(' ');
const nom = 'DROPLET ID'.split('');
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{titre}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#050506" />
  <link rel="icon" href={`${base}/logo.svg`} type="image/svg+xml" />
  <meta property="og:title" content={titre} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
</head>
<body>

<header class="nav">
  <div class="conteneur nav-ligne">
    <a class="marque" href="#haut" aria-label="Droplet ID, haut de page">
      <img src={`${base}/logo.svg`} alt="" width="28" height="28" />
      <span>Droplet ID</span>
    </a>
    <nav aria-label="Sections">
      <a href="#fonctionnement">Fonctionnement</a>
      <a href="#securite">Sécurité</a>
      <a href="#apps">Apps</a>
    </nav>
    <a class="nav-action" href={APK}>Télécharger</a>
  </div>
  <div class="progression" aria-hidden="true"></div>
</header>

<main id="haut">

  <!-- 1. LA CEINTURE SE BOUCLE. -->
  <section class="scene scene-hero" data-scene="epingle" id="hero">
    <div class="epingle">
      <div class="halo" aria-hidden="true"></div>
      <div class="hero-scene">
        <div class="hero-logo-cadre">
          <div class="hero-logo boite-logo"><Logo id="hero" taille={420} label="Le logo de Droplet ID : un cœur argenté tenu par une ceinture de sécurité" /></div>
        </div>
        <h1 class="titre-1 hero-titre">
          <span class="ligne-a">Votre identité.</span>
          <span class="ligne-b">Bouclée.</span>
        </h1>
        <p class="chapeau hero-chapeau">Une seule identité pour Droplet Messenger, Droplet Drop et Kunfox. Elle vit dans votre téléphone, et nulle part ailleurs.</p>
        <div class="actions hero-actions">
          <a class="bouton bouton-metal" href={APK}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"/></svg>
            Télécharger pour Android
          </a>
          <a class="bouton bouton-contour" href="#fonctionnement">Voir comment ça marche</a>
        </div>
      </div>
      <p class="indice" aria-hidden="true"><span></span>Faites défiler pour boucler</p>
    </div>
  </section>

  <!-- 2. LES TROIS GESTES. Le téléphone reste, l'écran change. -->
  <section class="scene scene-gestes" data-scene="epingle" id="fonctionnement">
    <div class="epingle">
      <div class="conteneur deux-colonnes">
        <div>
          <h2 class="titre-2">Sans mot de passe.<br />Sans e-mail.</h2>
          <p class="chapeau espace">Pour vous connecter, vous ne tapez rien que l'on puisse vous voler. Vous approuvez, sur votre téléphone.</p>
          <ol class="etapes">
            <li data-etape="0"><span class="num" aria-hidden="true">1</span><div><strong>Scannez le code</strong><p class="texte">Le site ou l'app affiche un QR. Droplet ID le lit.</p></div></li>
            <li data-etape="1"><span class="num" aria-hidden="true">2</span><div><strong>Vérifiez le nombre</strong><p class="texte">Vous recopiez le nombre affiché par le site. Une fausse page ne peut pas le deviner.</p></div></li>
            <li data-etape="2"><span class="num" aria-hidden="true">3</span><div><strong>Approuvez</strong><p class="texte">Votre empreinte ou le code de votre téléphone, et c'est fait.</p></div></li>
          </ol>
          <div class="barre-etapes" aria-hidden="true"><span></span></div>
        </div>

        <div class="telephone" role="img" aria-label="Trois écrans de Droplet ID : scanner le code, vérifier le nombre 482 913, connexion approuvée">
          <div class="ecran">
            <!-- écran 1 : scanner -->
            <div class="vue vue-scan" data-vue="0">
              <div class="viseur">
                <svg viewBox="-1 -1 23 23" class="qr" aria-hidden="true">
                  <path d={qr.join('')} fill="#e6e8eb"/>
                  {coins.map(([x, y]) => (<g><rect x={x + 0.5} y={y + 0.5} width="6" height="6" fill="none" stroke="#e6e8eb" stroke-width="1"/><rect x={x + 2} y={y + 2} width="3" height="3" fill="#e6e8eb"/></g>))}
                </svg>
                <span class="balayage"></span>
                <i class="c c1"></i><i class="c c2"></i><i class="c c3"></i><i class="c c4"></i>
              </div>
              <p class="vue-texte">Visez le code affiché par l'app</p>
            </div>
            <!-- écran 2 : le nombre -->
            <div class="vue vue-code" data-vue="1">
              <div class="feuille">
                <div class="poignee"></div>
                <img class="app-icone" src={`${base}/apps/kunfox.webp`} alt="" width="56" height="56" />
                <p class="feuille-titre">Se connecter à Kunfox ?</p>
                <p class="feuille-sous">kunfox.app</p>
                <div class="code-boite">
                  <span class="code-aide">Le nombre affiché sur kunfox.app</span>
                  <span class="code"><b>4</b><b>8</b><b>2</b> <b>9</b><b>1</b><b>3</b></span>
                </div>
                <div class="lignes">
                  <div><span>Kunfox recevra</span><span>Identifiant, pseudo</span></div>
                  <div><span>Expire dans</span><span class="chiffres">4:52</span></div>
                </div>
                <div class="btn-approuver">Se connecter</div>
              </div>
            </div>
            <!-- écran 3 : approuvé -->
            <div class="vue vue-ok" data-vue="2">
              <svg class="coche" viewBox="0 0 120 120" aria-hidden="true">
                <circle cx="60" cy="60" r="52" pathLength="1" />
                <path d="M38 62l15 15 30-32" pathLength="1" />
              </svg>
              <p class="ok-titre">Connecté à Kunfox</p>
              <p class="ok-sous">Vous pouvez revenir à l'app.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. LA CLÉ RESTE ICI. -->
  <section class="bloc bloc-sombre" id="securite" data-scene="vue">
    <div class="conteneur">
      <div class="centre">
        <h2 class="titre-2 mots" aria-label="Votre clé ne quitte jamais ce téléphone.">
          {motSecurite.map((m, i) => <span aria-hidden="true" style={`--i:${i}`}>{m} </span>)}
        </h2>
        <p class="chapeau centre-texte">Droplet ID crée une clé sur votre téléphone. Personne d'autre ne la possède, pas même Droplet.</p>
      </div>
      <div class="grille">
        <article class="carte" style="--i:0">
          <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="8" cy="15" r="4"/><path d="M11 12l9-9M17 6l3 3M15 8l2 2"/></svg>
          <h3 class="titre-3">Créée ici</h3>
          <p class="texte">Une clé Ed25519 naît dans le téléphone. Elle signe vos approbations ; elle n'est jamais envoyée.</p>
        </article>
        <article class="carte" style="--i:1">
          <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2.5"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
          <h3 class="titre-3">Gardée par la puce</h3>
          <p class="texte">Elle est chiffrée par le Keystore d'Android, et par la puce de sécurité quand le téléphone en a une.</p>
        </article>
        <article class="carte" style="--i:2">
          <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h10M4 17h7"/><path d="M17 15l4 4M21 15l-4 4"/></svg>
          <h3 class="titre-3">Hors des sauvegardes</h3>
          <p class="texte">Elle ne part ni dans le cloud ni vers un autre téléphone. Elle ne peut pas être copiée.</p>
        </article>
        <article class="carte" style="--i:3">
          <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="9" r="3.5"/><path d="M5.5 19a7 7 0 0 1 13 0"/><path d="M3 3l18 18"/></svg>
          <h3 class="titre-3">Rien de personnel</h3>
          <p class="texte">Ni numéro, ni e-mail, ni nom. Un pseudo, seulement si vous choisissez de le partager.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- 4. UN FIL VERS CHAQUE APP. -->
  <section class="bloc" id="apps" data-scene="vue">
    <div class="conteneur centre">
      <h2 class="titre-2">Un identifiant différent pour chaque app.</h2>
      <p class="chapeau centre-texte">Chaque app reçoit un identifiant qui ne vaut que pour elle. Deux apps ne peuvent pas savoir qu'il s'agit de vous.</p>
      <div class="reseau">
        <svg class="fils" viewBox="0 0 900 420" preserveAspectRatio="none" aria-hidden="true">
          <path pathLength="1" d="M450 120 C 450 220 150 220 150 330" />
          <path pathLength="1" d="M450 120 L 450 330" />
          <path pathLength="1" d="M450 120 C 450 220 750 220 750 330" />
        </svg>
        <div class="noeud-centre boite-logo"><Logo id="reseau" taille={104} /></div>
        <ul class="noeuds" aria-label="Apps qui utilisent Droplet ID">
          <li style="--i:0"><img src={`${base}/apps/messenger.webp`} alt="" width="64" height="64" /><strong>Droplet Messenger</strong><span class="ident">id · 7f3a…c21</span></li>
          <li style="--i:1"><img src={`${base}/apps/drop.webp`} alt="" width="64" height="64" /><strong>Droplet Drop</strong><span class="ident">id · b90e…4d7</span></li>
          <li style="--i:2"><img src={`${base}/apps/kunfox.webp`} alt="" width="64" height="64" /><strong>Kunfox</strong><span class="ident">id · 15c8…e02</span></li>
        </ul>
        <p class="note-ident">Trois apps, trois identifiants sans lien entre eux. Les identifiants affichés sont des exemples.</p>
      </div>
    </div>
  </section>

  <!-- 5. RETIRER, SOUS VOS YEUX. -->
  <section class="scene scene-retirer bloc-sombre" data-scene="epingle">
    <div class="epingle">
      <div class="conteneur centre">
        <h2 class="titre-2">Retirer un accès prend une seconde.</h2>
        <p class="chapeau centre-texte">Vous voyez chaque app qui utilise votre identité, depuis quand, et ce qu'elle reçoit. Un geste, et elle ne vous reconnaît plus.</p>
        <div class="liste-acces" aria-hidden="true">
          <div class="acces"><img src={`${base}/apps/messenger.webp`} alt="" width="44" height="44" /><span>Droplet Messenger</span><em>il y a 11 j</em></div>
          <div class="acces"><img src={`${base}/apps/drop.webp`} alt="" width="44" height="44" /><span>Droplet Drop</span><em>il y a 3 j</em></div>
          <div class="acces acces-retire"><img src={`${base}/apps/kunfox.webp`} alt="" width="44" height="44" /><span>Kunfox</span><b class="retirer-btn">Retirer l'accès</b></div>
          <p class="retire-msg">Accès de Kunfox retiré.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. FIN : le nom monte, la ceinture se reboucle. -->
  <section class="scene scene-fin" data-scene="epingle">
    <div class="epingle fin">
      <div class="lumiere" aria-hidden="true"></div>
      <div class="fin-contenu">
        <div class="fin-logo boite-logo"><Logo id="fin" taille={150} /></div>
        <h2 class="titre-2 fin-titre">Bouclez votre identité.</h2>
        <p class="chapeau centre-texte fin-chapeau">Gratuit. Pour Android 12 ou plus récent.</p>
        <div class="actions fin-actions">
          <a class="bouton bouton-metal" href={APK}>Télécharger pour Android</a>
          <a class="bouton bouton-contour" href={SOURCES}>Voir le code source</a>
        </div>
      </div>
      <p class="nom-geant" aria-hidden="true">{nom.map((l, i) => <span style={`--i:${i}`}>{l === ' ' ? ' ' : l}</span>)}</p>
    </div>
  </section>
</main>

<footer class="pied">
  <div class="conteneur pied-ligne">
    <span>© 2026 Droplet</span>
    <a href={SOURCES}>Code source</a>
    <span class="pied-note">Droplet ID est en test. Il n'est pas encore sur le Play Store.</span>
  </div>
</footer>

<script>
  import Lenis from 'lenis';

  const calme = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.documentElement.classList.toggle('anime', !calme);

  // Un défilement doux, avec de l'inertie (sauf si l'on demande moins d'animations).
  const lenis = calme ? null : new Lenis({ lerp: 0.09, smoothWheel: true });
  document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) => a.addEventListener('click', (e) => {
    const cible = document.querySelector(a.getAttribute('href')!);
    if (cible && lenis) { e.preventDefault(); lenis.scrollTo(cible as HTMLElement, { offset: 0 }); }
  }));

  const borne = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
  const plage = (p: number, a: number, b: number) => borne((p - a) / (b - a));
  const scenes = [...document.querySelectorAll<HTMLElement>('[data-scene]')];
  const barre = document.querySelector<HTMLElement>('.progression')!;

  // Le clic de la ceinture, joué une fois à chaque fois qu'elle se boucle.
  const clics = new Map<Element, boolean>();
  function boucler(logo: SVGElement | null, t: number) {
    if (!logo) return;
    logo.style.setProperty('--boucle', String(t));
    const ferme = t >= 0.999;
    if (ferme && !clics.get(logo)) {
      logo.classList.remove('clic'); void logo.getBoundingClientRect(); logo.classList.add('clic');
      navigator.vibrate?.(12);
    }
    clics.set(logo, ferme);
  }

  // Le logo du héros suit un peu le pointeur, en 3D.
  const cadre = document.querySelector<HTMLElement>('.hero-logo-cadre');
  window.addEventListener('pointermove', (e) => {
    if (calme || !cadre) return;
    const x = e.clientX / innerWidth - 0.5, y = e.clientY / innerHeight - 0.5;
    cadre.style.setProperty('--rx', `${(-y * 10).toFixed(2)}deg`);
    cadre.style.setProperty('--ry', `${(x * 14).toFixed(2)}deg`);
    const fin = document.querySelector<HTMLElement>('.fin');
    fin?.style.setProperty('--mx', `${e.clientX}px`);
    fin?.style.setProperty('--my', `${e.clientY}px`);
  }, { passive: true });

  function image(temps: number) {
    lenis?.raf(temps);
    const vh = innerHeight;
    barre.style.transform = `scaleX(${borne(scrollY / (document.documentElement.scrollHeight - vh))})`;
    for (const s of scenes) {
      const r = s.getBoundingClientRect();
      if (r.bottom < -vh || r.top > 2 * vh) continue;
      const p = s.dataset.scene === 'epingle'
        ? borne(-r.top / Math.max(1, r.height - vh))
        : borne((vh - r.top) / (vh + r.height));
      s.style.setProperty('--p', p.toFixed(4));

      if (s.id === 'hero') {
        boucler(s.querySelector('svg.logo'), calme ? 1 : plage(p, 0.08, 0.5));
        s.style.setProperty('--b', plage(p, 0.48, 0.66).toFixed(4));   // « Bouclée. »
        s.style.setProperty('--s', plage(p, 0.62, 0.8).toFixed(4));    // chapeau + boutons
        s.style.setProperty('--o', plage(p, 0.9, 1).toFixed(4));       // sortie
      }
      if (s.id === 'fonctionnement') {
        const etape = Math.min(2, Math.floor(plage(p, 0.05, 0.95) * 3));
        s.querySelectorAll<HTMLElement>('[data-etape]').forEach((el) => el.classList.toggle('active', Number(el.dataset.etape) <= etape));
        s.querySelectorAll<HTMLElement>('[data-vue]').forEach((el) => el.classList.toggle('active', Number(el.dataset.vue) === etape));
        s.style.setProperty('--e', plage(p, 0.05, 0.95).toFixed(4));
      }
      if (s.classList.contains('scene-retirer')) {
        s.style.setProperty('--r', plage(p, 0.35, 0.7).toFixed(4));
      }
      if (s.classList.contains('scene-fin')) {
        boucler(s.querySelector('svg.logo'), calme ? 1 : plage(p, 0.25, 0.6));
        s.style.setProperty('--n', plage(p, 0.05, 0.75).toFixed(4));
        s.style.setProperty('--c', plage(p, 0.55, 0.85).toFixed(4));
      }
    }
    requestAnimationFrame(image);
  }
  requestAnimationFrame(image);
</script>

<style>
  /* ---------- Barre de navigation ---------- */
  .nav { position: sticky; top: 0; z-index: 20; background: rgba(5,5,6,.72); backdrop-filter: saturate(160%) blur(18px); -webkit-backdrop-filter: saturate(160%) blur(18px); border-bottom: 1px solid var(--trait); }
  .nav-ligne { display: flex; align-items: center; gap: 24px; height: 56px; }
  .marque { display: flex; align-items: center; gap: 10px; text-decoration: none; font: 600 16px/1 var(--titres); letter-spacing: -0.01em; }
  .marque img { border-radius: 8px; }
  .nav nav { display: flex; gap: 22px; margin-left: auto; }
  .nav nav a { color: var(--argent-2); text-decoration: none; font-size: 14px; }
  .nav nav a:hover { color: var(--argent); }
  .nav-action { font-size: 14px; font-weight: 600; text-decoration: none; padding: 8px 14px; border-radius: 999px; background: var(--metal); color: #0e0f12; }
  .progression { position: absolute; left: 0; right: 0; bottom: -1px; height: 1px; background: linear-gradient(90deg, #8e939a, #fff); transform-origin: left; transform: scaleX(0); }
  @media (max-width: 640px) { .nav nav { display: none; } .nav-action { margin-left: auto; } }

  /* ---------- Scènes épinglées : la section est haute, son contenu reste à l'écran ---------- */
  .scene { position: relative; }
  .epingle { position: sticky; top: 0; height: 100svh; display: flex; align-items: center; justify-content: center; overflow: hidden; }
  html:not(.anime) .scene { height: auto !important; }
  html:not(.anime) .epingle { position: relative; height: auto; padding: 120px 0; }

  /* ---------- 1. Héros ---------- */
  .scene-hero { height: 260vh; }
  .halo { position: absolute; left: 50%; top: 50%; width: 1100px; height: 1100px; transform: translate(-50%, -50%) scale(calc(0.8 + var(--b, 1) * 0.3)); background: radial-gradient(closest-side, rgba(200,204,212,calc(0.06 + var(--b, 1) * 0.1)), transparent 70%); pointer-events: none; }
  .hero-scene { position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 22px; padding: 0 20px; opacity: calc(1 - var(--o, 0)); transform: translateY(calc(var(--o, 0) * -60px)); }
  .hero-logo-cadre { perspective: 900px; }
  .boite-logo { border-radius: 30%; overflow: hidden; }
  .boite-logo :global(svg) { width: 100%; height: 100%; }
  .hero-logo { width: clamp(150px, min(34vw, 30vh), 300px); aspect-ratio: 1; box-shadow: 0 50px 120px rgba(0,0,0,.8), 0 0 0 1px rgba(255,255,255,.08);
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)) scale(calc(1.18 - var(--s, 1) * 0.32)); transition: transform 600ms var(--courbe); }
  .hero-titre { display: flex; flex-direction: column; align-items: center; }
  .ligne-b { opacity: var(--b, 1); filter: blur(calc((1 - var(--b, 1)) * 14px)); transform: translateY(calc((1 - var(--b, 1)) * 24px)); }
  .hero-chapeau { text-align: center; opacity: var(--s, 1); transform: translateY(calc((1 - var(--s, 1)) * 20px)); }
  .hero-actions { opacity: var(--s, 1); transform: translateY(calc((1 - var(--s, 1)) * 20px)); pointer-events: auto; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
  .indice { position: absolute; bottom: 28px; left: 0; right: 0; margin: 0; display: flex; flex-direction: column; align-items: center; gap: 10px; font-size: 12px; color: var(--argent-3); letter-spacing: .02em; opacity: calc(1 - var(--s, 1)); }
  .indice span { width: 1px; height: 36px; background: linear-gradient(transparent, var(--argent-2)); animation: indice 1.8s var(--courbe) infinite; transform-origin: top; }
  @keyframes indice { 0% { transform: scaleY(0); } 60% { transform: scaleY(1); opacity: 1; } 100% { transform: scaleY(1); opacity: 0; } }

  /* ---------- 2. Les gestes ---------- */
  .scene-gestes { height: 340vh; }
  .deux-colonnes { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(40px, 6vw, 96px); align-items: center; }
  .espace { margin-top: 20px; }
  .etapes { list-style: none; padding: 0; margin: 40px 0 0; display: flex; flex-direction: column; gap: 22px; }
  .etapes li { display: flex; gap: 16px; align-items: flex-start; opacity: .32; transition: opacity 500ms var(--courbe), transform 500ms var(--courbe); }
  .etapes li.active { opacity: 1; }
  html:not(.anime) .etapes li { opacity: 1; }
  .etapes strong { display: block; font-weight: 600; font-size: 18px; margin-bottom: 2px; }
  .num { flex: none; width: 32px; height: 32px; border-radius: 999px; display: grid; place-items: center; font: 600 15px/1 var(--titres); color: #0e0f12; background: var(--metal); }
  .barre-etapes { margin-top: 32px; height: 2px; width: min(320px, 100%); background: var(--graphite-2); border-radius: 2px; overflow: hidden; }
  .barre-etapes span { display: block; height: 100%; background: var(--metal); transform-origin: left; transform: scaleX(var(--e, 1)); }

  .telephone { justify-self: center; width: min(320px, 80vw, 46vh); aspect-ratio: 9 / 19; border-radius: 50px; padding: 11px; background: linear-gradient(160deg, #3a3d43, #121316 40%, #2a2c31); box-shadow: 0 40px 100px rgba(0,0,0,.75), 0 0 0 1px rgba(255,255,255,.1);
    transform: perspective(1200px) rotateY(calc((0.5 - var(--e, .5)) * 16deg)) rotateX(4deg); }
  .ecran { position: relative; height: 100%; border-radius: 40px; background: radial-gradient(120% 60% at 50% 0%, #1b1c20, #050506 70%); overflow: hidden; }
  .vue { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; opacity: 0; transform: scale(.96); transition: opacity 600ms var(--courbe), transform 600ms var(--courbe); }
  .vue.active { opacity: 1; transform: none; }
  html:not(.anime) .vue-code { opacity: 1; transform: none; }
  .viseur { position: relative; width: 62%; aspect-ratio: 1; padding: 10%; }
  .qr { width: 100%; height: 100%; opacity: .9; }
  .balayage { position: absolute; left: 6%; right: 6%; height: 2px; top: 10%; background: linear-gradient(90deg, transparent, var(--rouge), transparent); box-shadow: 0 0 18px var(--rouge); animation: balaye 2.2s ease-in-out infinite alternate; }
  @keyframes balaye { to { top: 88%; } }
  .c { position: absolute; width: 22%; height: 22%; border: 3px solid #fff; }
  .c1 { top: 0; left: 0; border-right: 0; border-bottom: 0; border-top-left-radius: 14px; }
  .c2 { top: 0; right: 0; border-left: 0; border-bottom: 0; border-top-right-radius: 14px; }
  .c3 { bottom: 0; left: 0; border-right: 0; border-top: 0; border-bottom-left-radius: 14px; }
  .c4 { bottom: 0; right: 0; border-left: 0; border-top: 0; border-bottom-right-radius: 14px; }
  .vue-texte { margin: 28px 0 0; font-size: 13px; color: var(--argent-2); }
  .vue-code { justify-content: flex-end; }
  .feuille { width: 100%; background: #16171a; border-radius: 30px 30px 0 0; padding: 10px 18px 26px; display: flex; flex-direction: column; align-items: center; border-top: 1px solid var(--trait); }
  .poignee { width: 36px; height: 5px; border-radius: 999px; background: #3a3c41; margin-bottom: 16px; }
  .app-icone { width: 52px; height: 52px; border-radius: 13px; }
  .feuille-titre { margin: 12px 0 2px; font: 700 18px/1.2 var(--titres); letter-spacing: -0.015em; color: #fff; }
  .feuille-sous { margin: 0; font-size: 12.5px; color: var(--argent-2); }
  .code-boite { align-self: stretch; margin-top: 16px; background: #202227; border-radius: 18px; padding: 14px; display: flex; flex-direction: column; align-items: center; gap: 6px; }
  .code-aide { font-size: 11px; color: var(--argent-2); }
  .code { font: 700 30px/1 var(--titres); letter-spacing: 0.04em; font-variant-numeric: tabular-nums; color: #fff; }
  .code b { display: inline-block; font-weight: 700; }
  .vue-code.active .code b { animation: chiffre 500ms var(--courbe) both; }
  .vue-code.active .code b:nth-child(2) { animation-delay: 60ms; } .vue-code.active .code b:nth-child(3) { animation-delay: 120ms; }
  .vue-code.active .code b:nth-child(4) { animation-delay: 180ms; } .vue-code.active .code b:nth-child(5) { animation-delay: 240ms; } .vue-code.active .code b:nth-child(6) { animation-delay: 300ms; }
  @keyframes chiffre { from { opacity: 0; transform: translateY(10px); filter: blur(6px); } }
  .lignes { align-self: stretch; margin-top: 10px; background: #202227; border-radius: 18px; }
  .lignes div { display: flex; justify-content: space-between; padding: 11px 14px; font-size: 12.5px; }
  .lignes div + div { border-top: 1px solid var(--trait); }
  .lignes span:last-child { color: var(--argent-2); }
  .chiffres { font-variant-numeric: tabular-nums; }
  .btn-approuver { align-self: stretch; margin-top: 16px; height: 44px; border-radius: 14px; display: grid; place-items: center; font-weight: 600; font-size: 15px; color: #0e0f12; background: var(--metal); }
  .coche { width: 112px; height: 112px; fill: none; stroke: #fff; stroke-width: 5; stroke-linecap: round; stroke-linejoin: round; }
  .coche circle, .coche path { stroke-dasharray: 1; stroke-dashoffset: 1; }
  .coche circle { stroke: rgba(255,255,255,.25); }
  .vue-ok.active .coche circle { animation: trace 700ms var(--courbe) forwards; }
  .vue-ok.active .coche path { animation: trace 500ms 450ms var(--courbe) forwards; }
  @keyframes trace { to { stroke-dashoffset: 0; } }
  .ok-titre { margin: 22px 0 4px; font: 700 20px/1.2 var(--titres); color: #fff; }
  .ok-sous { margin: 0; font-size: 13px; color: var(--argent-2); }
  @media (max-width: 860px) {
    .scene-gestes .deux-colonnes { grid-template-columns: 1fr; gap: 24px; }
    .scene-gestes .chapeau, .scene-gestes .barre-etapes { display: none; }
    .scene-gestes .etapes { margin-top: 16px; gap: 10px; }
    .scene-gestes .etapes .texte { display: none; }
    .telephone { width: min(240px, 60vw, 44vh); }
  }

  /* ---------- 3. Sécurité : le titre s'allume mot à mot ---------- */
  .bloc { padding: clamp(96px, 14vw, 180px) 0; }
  .bloc-sombre { background: var(--noir-2); border-block: 1px solid var(--trait); }
  .centre { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 20px; }
  .centre-texte { text-align: center; margin-inline: auto; }
  .mots { max-width: 16ch; background: none; color: var(--argent); -webkit-text-fill-color: currentColor; }
  .mots span { opacity: calc(0.14 + 0.86 * clamp(0, (var(--p, 1) - 0.12) * 22 - var(--i), 1)); transition: opacity 200ms linear; }
  .grille { margin-top: 64px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; perspective: 1400px; }
  @media (max-width: 980px) { .grille { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .grille { grid-template-columns: 1fr; } }
  .carte { background: linear-gradient(180deg, #1d1e23, #15161a); border: 1px solid var(--trait); border-radius: 24px; padding: 28px 24px; display: flex; flex-direction: column; gap: 12px;
    --q: clamp(0, (var(--p, 1) - 0.32 - var(--i) * 0.05) * 6, 1);
    opacity: var(--q); transform: translateY(calc((1 - var(--q)) * 60px)) rotateX(calc((1 - var(--q)) * 18deg)); transform-origin: top; }
  .ic { width: 30px; height: 30px; fill: none; stroke: var(--argent); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; margin-bottom: 6px; }

  /* ---------- 4. Les fils vers les apps ---------- */
  .reseau { position: relative; width: min(900px, 100%); margin-top: 56px; aspect-ratio: 900 / 470; }
  .fils { position: absolute; inset: 0 0 auto 0; width: 100%; height: calc(100% * 420 / 470); }
  .fils path { fill: none; stroke: rgba(230,232,235,.5); stroke-width: 1.5; vector-effect: non-scaling-stroke; stroke-dasharray: 1; stroke-dashoffset: calc(1 - clamp(0, (var(--p, 1) - 0.28) * 3.4, 1)); }
  .noeud-centre { position: absolute; left: 50%; top: calc(100% * 120 / 470); transform: translate(-50%, -50%); }
  .noeud-centre { width: 104px; height: 104px; box-shadow: 0 20px 60px rgba(0,0,0,.7), 0 0 0 1px rgba(255,255,255,.08); }
  .noeuds { list-style: none; margin: 0; padding: 0; position: absolute; left: 0; right: 0; top: calc(100% * 330 / 470); display: grid; grid-template-columns: repeat(3, 1fr); }
  .noeuds li { display: flex; flex-direction: column; align-items: center; gap: 8px; transform: translateY(-32px);
    --q: clamp(0, (var(--p, 1) - 0.5 - var(--i) * 0.04) * 8, 1); opacity: var(--q); }
  .noeuds img { width: 64px; height: 64px; border-radius: 16px; box-shadow: 0 0 0 1px rgba(255,255,255,.1), 0 14px 30px rgba(0,0,0,.6); transform: scale(calc(0.7 + var(--q) * 0.3)); }
  .noeuds strong { font-weight: 600; font-size: 15px; }
  .ident { font: 500 12px/1 var(--texte); color: var(--argent-3); font-variant-numeric: tabular-nums; letter-spacing: .02em; }
  .note-ident { position: absolute; left: 0; right: 0; bottom: -8px; margin: 0; font-size: 12px; color: var(--argent-3); }
  @media (max-width: 560px) { .noeuds strong { font-size: 12.5px; } .noeuds img { width: 48px; height: 48px; } .reseau { aspect-ratio: 900 / 640; } }

  /* ---------- 5. Retirer ---------- */
  .scene-retirer { height: 220vh; }
  .liste-acces { position: relative; margin-top: 28px; width: min(440px, 100%); display: flex; flex-direction: column; gap: 8px; text-align: left; }
  .acces { display: flex; align-items: center; gap: 14px; padding: 12px 12px 12px 14px; background: var(--graphite); border: 1px solid var(--trait); border-radius: 18px; }
  .acces img { border-radius: 11px; }
  .acces span { flex: 1; font-weight: 600; }
  .acces em { font-style: normal; font-size: 13px; color: var(--argent-3); }
  .acces-retire { --r2: var(--r, 1); transform: translateX(calc(var(--r2) * -115%)); opacity: calc(1 - var(--r2)); }
  .retirer-btn { background: var(--rouge); color: #fff; font-weight: 600; font-size: 13.5px; padding: 9px 14px; border-radius: 999px; }
  .retire-msg { margin: 6px 0 0; text-align: center; font-size: 14px; color: var(--argent-2); opacity: clamp(0, (var(--r, 1) - 0.7) * 4, 1); }
  html:not(.anime) .acces-retire { display: none; }

  /* ---------- 6. Fin ---------- */
  .scene-fin { height: 230vh; }
  .fin { flex-direction: column; background: var(--noir); }
  .lumiere { position: absolute; inset: 0; background: radial-gradient(600px circle at var(--mx, 50%) var(--my, 40%), rgba(200,204,212,.09), transparent 60%); pointer-events: none; }
  .fin-contenu { position: relative; z-index: 2; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 18px; padding: 0 20px; margin-bottom: 6vh; }
  .fin-logo { box-shadow: 0 24px 60px rgba(0,0,0,.6), 0 0 0 1px rgba(255,255,255,.08); width: clamp(96px, 16vh, 150px); aspect-ratio: 1;
    transform: translateY(calc((1 - var(--n, 1)) * 80px)) scale(calc(0.85 + var(--n, 1) * 0.15)); opacity: clamp(0, var(--n, 1) * 3, 1); }
  .fin-titre, .fin-chapeau, .fin-actions { opacity: var(--c, 1); transform: translateY(calc((1 - var(--c, 1)) * 30px)); }
  .nom-geant { position: absolute; left: 0; right: 0; bottom: 0.04em; margin: 0; display: flex; justify-content: center; font: 800 clamp(64px, 17.5vw, 300px)/0.9 var(--titres); letter-spacing: -0.05em; white-space: nowrap; pointer-events: none; }
  .nom-geant span { display: inline-block; background: linear-gradient(180deg, rgba(255,255,255,.22), rgba(255,255,255,0) 85%); -webkit-background-clip: text; background-clip: text; color: transparent;
    --q: clamp(0, var(--n, 1) * 1.7 - var(--i) * 0.07, 1); transform: translateY(calc((1 - var(--q)) * 110%)) rotate(calc((1 - var(--q)) * 8deg)); opacity: var(--q); }

  .pied { border-top: 1px solid var(--trait); padding: 28px 0 40px; font-size: 13px; color: var(--argent-3); background: var(--noir); position: relative; z-index: 2; }
  .pied-ligne { display: flex; flex-wrap: wrap; gap: 8px 24px; align-items: center; }
  .pied a { color: var(--argent-2); text-decoration: none; }
  .pied a:hover { color: var(--argent); }
  .pied-note { margin-left: auto; }
  @media (max-width: 640px) { .pied-note { margin-left: 0; } }
</style>

---
// SÉCURITÉ — comment une approbation est signée, ce qui protège la clé,
// et, honnêtement, ce qui n'est pas encore fait.
import Page from '../layouts/Page.astro';
import { SOURCES } from '../site';
const titre = ['Une', 'signature', 'que', 'personne', 'ne', 'peut', 'imiter.'];
const lignes = [
  ['Méthode', 'POST'],
  ['Chemin', '/demandes/d1/approuver'],
  ['Horodatage', '2026-11-24T14:05:12Z'],
  ['Nonce', 'k7Q9 2xAb Lm4T z8Wc'],
  ['Empreinte du corps', 'sha256 · 9f2c…41ab'],
];
---
<Page titre="Sécurité" description="Comment Droplet ID signe chaque approbation, ce qui protège votre clé, et ce qui reste à faire." courant="securite">
  <section class="surtitre-page" data-scene="vue">
    <div class="conteneur centre">
      <p class="sur apparait">Sécurité</p>
      <h1 class="titre-1 mots grand-mots" aria-label="Une signature que personne ne peut imiter.">
        {titre.map((m, i) => <span aria-hidden="true" style={`--i:${i}`}>{m + ' '}</span>)}
      </h1>
      <p class="chapeau centre-texte apparait" style="--d:2">Chaque fois que vous approuvez, votre téléphone signe la demande avec sa clé. Le serveur vérifie la signature avant de faire quoi que ce soit.</p>
    </div>
  </section>

  <!-- La signature, pas à pas. -->
  <section class="scene signature-scene" data-scene="epingle" id="signature">
    <div class="epingle">
      <div class="conteneur sig-grille">
        <div class="sig-texte">
          <h2 class="titre-2">Ce que le téléphone signe.</h2>
          <p class="chapeau">Cinq éléments, mis bout à bout. L'horodatage et le nonce empêchent de rejouer une ancienne approbation. L'empreinte empêche de modifier la demande en route.</p>
        </div>
        <div class="sig-carte" role="img" aria-label="Le texte signé : méthode, chemin, horodatage, nonce et empreinte du corps, puis la signature Ed25519 vérifiée par le serveur">
          {lignes.map(([k, v], i) => (
            <div class="sig-ligne" style={`--i:${i}`}><span>{k}</span><code>{v}</code></div>
          ))}
          <div class="sig-sep"></div>
          <div class="sig-resultat">
            <span>Signature Ed25519</span>
            <code class="sig-hex">x9Lk…Qw2</code>
          </div>
          <div class="sceau"><svg viewBox="0 0 120 120"><circle cx="60" cy="60" r="50" pathLength="1"/><path d="M40 62l13 13 28-30" pathLength="1"/></svg><span>Vérifiée par le serveur</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="bloc bloc-sombre">
    <div class="conteneur">
      <h2 class="titre-2 apparait">Ce qui protège votre clé.</h2>
      <div class="protections">
        <article class="apparait" style="--d:0"><h3 class="titre-3">Elle naît dans le téléphone</h3><p class="texte">La clé Ed25519 est créée sur l'appareil. Seule sa partie publique est envoyée, pour vérifier vos signatures.</p></article>
        <article class="apparait" style="--d:1"><h3 class="titre-3">Elle est chiffrée</h3><p class="texte">Le coffre de l'app est chiffré par Tink. La clé de ce coffre vit dans le Keystore d'Android, et dans la puce de sécurité quand le téléphone en a une.</p></article>
        <article class="apparait" style="--d:2"><h3 class="titre-3">Elle ne sort pas</h3><p class="texte">Les données de l'app sont exclues des sauvegardes Android : rien ne part dans le cloud ni vers un autre téléphone.</p></article>
        <article class="apparait" style="--d:3"><h3 class="titre-3">Elle demande votre accord</h3><p class="texte">Une approbation passe par le verrouillage de votre téléphone : empreinte, visage ou code.</p></article>
        <article class="apparait" style="--d:4"><h3 class="titre-3">Le nombre déjoue les fausses pages</h3><p class="texte">Vous recopiez le nombre affiché par le vrai site. Une page qui imite le site ne peut pas l'afficher.</p></article>
        <article class="apparait" style="--d:5"><h3 class="titre-3">Tout passe chiffré</h3><p class="texte">L'app refuse toute connexion non chiffrée vers le serveur.</p></article>
      </div>
    </div>
  </section>

  <section class="bloc">
    <div class="conteneur honnete apparait">
      <h2 class="titre-2">Ce qui n'est pas encore fait.</h2>
      <p class="chapeau">On préfère vous le dire.</p>
      <ul>
        <li><strong>Pas encore de récupération.</strong> Si vous perdez votre téléphone, il faut recréer une identité et vous reconnecter à vos apps.</li>
        <li><strong>Pas encore d'audit externe.</strong> Le code est public, mais aucun cabinet indépendant ne l'a encore relu.</li>
        <li><strong>Pas encore de passkeys synchronisées.</strong> Elles arriveront avec le passage à Credential Manager d'Android.</li>
        <li><strong>Pas encore testé à grande échelle.</strong> Droplet ID est en version de test.</li>
      </ul>
      <a class="bouton bouton-contour" href={SOURCES}>Lire le code source</a>
    </div>
  </section>
</Page>

<script>
  import { surScene, plage } from '../scripts/moteur';
  const hex = '0123456789abcdefABCDEFghijkLMNOPqrstuvwxyz';
  const cible = 'x9LkV3t…8bQw2';
  surScene(document.getElementById('signature'), (p, s) => {
    s.style.setProperty('--l', String(plage(p, 0.05, 0.5)));
    s.style.setProperty('--h', String(plage(p, 0.5, 0.7)));
    s.style.setProperty('--v', String(plage(p, 0.72, 0.9)));
    const el = s.querySelector<HTMLElement>('.sig-hex');
    if (el) {
      const t = plage(p, 0.5, 0.7);
      el.textContent = t >= 1 ? cible : cible.split('').map((c, i) => (i / cible.length < t ? c : hex[(Math.random() * hex.length) | 0])).join('');
    }
    s.querySelector('.sceau')?.classList.toggle('pose', p > 0.74);
  });
</script>

<style>
  .sur { margin: 0; font-size: 14px; font-weight: 600; color: var(--argent-2); letter-spacing: .02em; }
  .grand-mots { max-width: 14ch; }
  .signature-scene { height: 320vh; }
  .sig-grille { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 6vw; align-items: center; }
  @media (max-width: 860px) { .sig-grille { grid-template-columns: 1fr; gap: 28px; } .sig-texte .chapeau { display: none; } }
  .sig-texte { display: flex; flex-direction: column; gap: 20px; }
  .sig-carte { position: relative; background: var(--surface); border: 1px solid var(--trait); border-radius: 28px; padding: 28px; font-size: 14px; }
  .sig-ligne { display: flex; justify-content: space-between; gap: 16px; padding: 11px 0; border-bottom: 1px solid var(--trait);
    --q: clamp(0, var(--l, 1) * 6 - var(--i), 1); opacity: var(--q); transform: translateX(calc((1 - var(--q)) * 30px)); }
  .sig-ligne span { color: var(--argent-2); }
  code { font: 500 13.5px/1.3 var(--police-mono); color: var(--encre); text-align: right; overflow-wrap: anywhere; }
  .sig-sep { height: 16px; }
  .sig-resultat { display: flex; justify-content: space-between; align-items: center; padding: 14px 16px; border-radius: 14px; background: color-mix(in srgb, var(--encre) 5%, transparent); opacity: calc(0.2 + var(--h, 1) * 0.8); }
  .sig-resultat span { font-weight: 600; }
  .sceau { display: flex; align-items: center; gap: 12px; margin-top: 18px; opacity: var(--v, 1); }
  .sceau svg { width: 44px; height: 44px; fill: none; stroke: var(--encre); stroke-width: 6; stroke-linecap: round; stroke-linejoin: round; }
  .sceau circle, .sceau path { stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 700ms var(--courbe); }
  .sceau path { transition-delay: 300ms; }
  .sceau.pose circle, .sceau.pose path, html:not(.anime) .sceau circle, html:not(.anime) .sceau path { stroke-dashoffset: 0; }
  .sceau span { font-weight: 600; }
  .protections { margin-top: 48px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  @media (max-width: 900px) { .protections { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .protections { grid-template-columns: 1fr; } }
  .protections article { background: var(--graphite); border: 1px solid var(--trait); border-radius: 24px; padding: 28px 24px; display: flex; flex-direction: column; gap: 12px; }
  .honnete { display: flex; flex-direction: column; gap: 20px; max-width: 760px; }
  .honnete ul { list-style: none; padding: 0; margin: 8px 0 12px; display: flex; flex-direction: column; gap: 16px; }
  .honnete li { color: var(--argent-2); padding-left: 22px; position: relative; }
  .honnete li::before { content: ''; position: absolute; left: 0; top: .65em; width: 10px; height: 2px; background: var(--rouge); }
  .honnete strong { color: var(--argent); }
  .honnete .bouton { align-self: flex-start; }
</style>
